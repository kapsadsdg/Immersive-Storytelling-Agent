# HOW TO USE
#   1. Copy this file to `.env`  (Windows: copy .env.example .env)
#   2. Fill in ONE provider's key in `.env`, NOT in this template.
#   3. No spaces around `=`:  ANTHROPIC_API_KEY=sk-ant-...
# `.env` is git-ignored. Never commit real keys.
# Non-empty values in `.env` take priority over system environment variables.

# Which LLM backend to use: anthropic | openai | mock
# If unset: anthropic when ANTHROPIC_API_KEY is set, else openai when
# OPENAI_API_KEY is set, else the offline mock (canned demo story).
LLM_PROVIDER=

# --- Anthropic (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Re-run a refused request on a fallback model inside the same API call.
ANTHROPIC_REFUSAL_FALLBACK=true
# Leave empty for the official API. Set https://api.anthropic.com explicitly if an
# inherited ANTHROPIC_BASE_URL environment variable points somewhere else.
ANTHROPIC_BASE_URL=

# --- OpenAI or any OpenAI-compatible server (Ollama, vLLM, LM Studio...) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# e.g. http://localhost:11434/v1 for Ollama (set OPENAI_API_KEY=ollama)
OPENAI_BASE_URL=

# --- Agent behaviour -----------------------------------------------------
# Reasoning effort per agent role (Anthropic only): low | medium | high | xhigh | max
EFFORT_WORLD_ARCHITECT=medium
EFFORT_PLOT_PLANNER=medium
EFFORT_INTENT_INTERPRETER=low
EFFORT_SCENE_DIRECTOR=low
EFFORT_CHARACTER_AGENT=low
EFFORT_NARRATOR=medium
EFFORT_NARRATIVE_CRITIC=low
EFFORT_CHRONICLER=low
# Let the Narrative Critic review key scenes and send a flawed one back to the Narrator once.
SELF_CORRECTION=true
# Language the story is written in. Use "auto" to follow the language of the theme.
STORY_LANGUAGE=English
# Where story sessions are saved as JSON.
SAVE_DIR=saves
